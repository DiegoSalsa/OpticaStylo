<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_OpticaStylo_VentaPresencial_AsIs"
  targetNamespace="https://opticastylo.cl/bpmn/venta-presencial-as-is">

  <bpmn:message id="Message_SolicitudAtencion" name="Solicitud de atención" />

  <bpmn:collaboration id="Collaboration_VentaPresencial">
    <bpmn:documentation>BORRADOR PENDIENTE DE VALIDACIÓN. El repositorio no documenta el proceso presencial vigente; este modelo es una hipótesis de levantamiento.</bpmn:documentation>
    <bpmn:participant id="Participant_Cliente" name="Cliente" processRef="Process_Cliente" />
    <bpmn:participant id="Participant_Optica" name="Óptica Stylo" processRef="Process_Optica" />
    <bpmn:messageFlow id="MessageFlow_Solicitud" name="Solicitud de atención" sourceRef="Task_Cliente_LlegarSolicitar" targetRef="Start_Optica_Solicitud" />
    <bpmn:messageFlow id="MessageFlow_Necesidad" name="Necesidad de compra" sourceRef="Task_Cliente_ExpresarNecesidad" targetRef="Task_Optica_IdentificarNecesidad" />
    <bpmn:messageFlow id="MessageFlow_Alternativas" name="Alternativas disponibles" sourceRef="Task_Optica_PresentarAlternativas" targetRef="Task_Cliente_EvaluarPropuesta" />
    <bpmn:messageFlow id="MessageFlow_Propuesta" name="Precio y plazo" sourceRef="Task_Optica_InformarPrecioPlazo" targetRef="Task_Cliente_EvaluarPropuesta" />
    <bpmn:messageFlow id="MessageFlow_Rechazo" name="Rechazo" sourceRef="Task_Cliente_ComunicarRechazo" targetRef="Task_Optica_RecibirDecision" />
    <bpmn:messageFlow id="MessageFlow_Aceptacion" name="Aceptación" sourceRef="Task_Cliente_ComunicarAceptacion" targetRef="Task_Optica_RecibirDecision" />
    <bpmn:messageFlow id="MessageFlow_SolicitudDatos" name="Solicitud de datos y pago" sourceRef="Task_Optica_SolicitarDatosPago" targetRef="Task_Cliente_DatosPago" />
    <bpmn:messageFlow id="MessageFlow_DatosPago" name="Datos y pago" sourceRef="Task_Cliente_DatosPago" targetRef="Task_Optica_RegistrarVentaPago" />
    <bpmn:messageFlow id="MessageFlow_Comprobante" name="Comprobante e indicaciones" sourceRef="Task_Optica_EntregarComprobante" targetRef="Task_Cliente_RecibirComprobante" />
    <bpmn:messageFlow id="MessageFlow_Producto" name="Producto" sourceRef="Task_Optica_EntregarProducto" targetRef="Task_Cliente_RecibirProducto" />
    <bpmn:messageFlow id="MessageFlow_Retiro" name="Plazo y retiro" sourceRef="Task_Optica_CoordinarPreparacion" targetRef="Task_Cliente_EsperarPreparacion" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Cliente" name="Participación del cliente" isExecutable="false">
    <bpmn:startEvent id="Start_Cliente" name="Inicio" />
    <bpmn:task id="Task_Cliente_LlegarSolicitar" name="Llegar al local y solicitar atención" />
    <bpmn:task id="Task_Cliente_ExpresarNecesidad" name="Expresar necesidad de compra" />
    <bpmn:task id="Task_Cliente_EvaluarPropuesta" name="Evaluar propuesta comercial" />
    <bpmn:exclusiveGateway id="Gateway_Cliente_Acepta" name="¿Acepta la propuesta?" gatewayDirection="Diverging" />
    <bpmn:task id="Task_Cliente_ComunicarRechazo" name="Comunicar rechazo" />
    <bpmn:endEvent id="End_Cliente_SinCompra" name="Compra no realizada" />
    <bpmn:task id="Task_Cliente_ComunicarAceptacion" name="Comunicar aceptación" />
    <bpmn:task id="Task_Cliente_DatosPago" name="Proporcionar datos y realizar pago" />
    <bpmn:task id="Task_Cliente_RecibirComprobante" name="Recibir comprobante e indicaciones" />
    <bpmn:exclusiveGateway id="Gateway_Cliente_Entrega" name="¿Recibe el producto ahora?" gatewayDirection="Diverging" />
    <bpmn:task id="Task_Cliente_RecibirProducto" name="Recibir producto" />
    <bpmn:endEvent id="End_Cliente_CompraCompletada" name="Compra completada" />
    <bpmn:task id="Task_Cliente_EsperarPreparacion" name="Esperar preparación o retiro" />
    <bpmn:endEvent id="End_Cliente_PendienteEntrega" name="Compra pendiente de entrega" />

    <bpmn:sequenceFlow id="CFlow_01" sourceRef="Start_Cliente" targetRef="Task_Cliente_LlegarSolicitar" />
    <bpmn:sequenceFlow id="CFlow_02" sourceRef="Task_Cliente_LlegarSolicitar" targetRef="Task_Cliente_ExpresarNecesidad" />
    <bpmn:sequenceFlow id="CFlow_03" sourceRef="Task_Cliente_ExpresarNecesidad" targetRef="Task_Cliente_EvaluarPropuesta" />
    <bpmn:sequenceFlow id="CFlow_04" sourceRef="Task_Cliente_EvaluarPropuesta" targetRef="Gateway_Cliente_Acepta" />
    <bpmn:sequenceFlow id="CFlow_05_No" name="No" sourceRef="Gateway_Cliente_Acepta" targetRef="Task_Cliente_ComunicarRechazo" />
    <bpmn:sequenceFlow id="CFlow_06" sourceRef="Task_Cliente_ComunicarRechazo" targetRef="End_Cliente_SinCompra" />
    <bpmn:sequenceFlow id="CFlow_07_Si" name="Sí" sourceRef="Gateway_Cliente_Acepta" targetRef="Task_Cliente_ComunicarAceptacion" />
    <bpmn:sequenceFlow id="CFlow_08" sourceRef="Task_Cliente_ComunicarAceptacion" targetRef="Task_Cliente_DatosPago" />
    <bpmn:sequenceFlow id="CFlow_09" sourceRef="Task_Cliente_DatosPago" targetRef="Task_Cliente_RecibirComprobante" />
    <bpmn:sequenceFlow id="CFlow_10" sourceRef="Task_Cliente_RecibirComprobante" targetRef="Gateway_Cliente_Entrega" />
    <bpmn:sequenceFlow id="CFlow_11_Si" name="Sí" sourceRef="Gateway_Cliente_Entrega" targetRef="Task_Cliente_RecibirProducto" />
    <bpmn:sequenceFlow id="CFlow_12" sourceRef="Task_Cliente_RecibirProducto" targetRef="End_Cliente_CompraCompletada" />
    <bpmn:sequenceFlow id="CFlow_13_No" name="No" sourceRef="Gateway_Cliente_Entrega" targetRef="Task_Cliente_EsperarPreparacion" />
    <bpmn:sequenceFlow id="CFlow_14" sourceRef="Task_Cliente_EsperarPreparacion" targetRef="End_Cliente_PendienteEntrega" />
  </bpmn:process>

  <bpmn:process id="Process_Optica" name="Proceso de Óptica Stylo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Optica">
      <bpmn:lane id="Lane_Ventas" name="Personal de atención y ventas">
        <bpmn:flowNodeRef>Start_Optica_Solicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Optica_IdentificarNecesidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Optica_PresentarAlternativas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Optica_RequiereEvaluacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Optica_UnirEvaluacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Optica_DefinirProducto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Optica_InformarPrecioPlazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Optica_RecibirDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Optica_Acepta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Optica_CerrarSinVenta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Optica_SinVenta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Optica_SolicitarDatosPago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Optica_RegistrarVentaPago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Optica_EntregarComprobante</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Optica_EntregaInmediata</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Optica_EntregarProducto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Optica_VentaEntregada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Optica_CoordinarPreparacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Optica_PendienteEntrega</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Clinica" name="Profesional clínico">
        <bpmn:flowNodeRef>SubProcess_AtencionClinica</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Optica_Solicitud" name="Solicitud de atención recibida">
      <bpmn:messageEventDefinition id="MessageEventDefinition_Solicitud" messageRef="Message_SolicitudAtencion" />
    </bpmn:startEvent>
    <bpmn:task id="Task_Optica_IdentificarNecesidad" name="Identificar necesidad comercial" />
    <bpmn:task id="Task_Optica_PresentarAlternativas" name="Presentar alternativas disponibles" />
    <bpmn:exclusiveGateway id="Gateway_Optica_RequiereEvaluacion" name="¿Requiere evaluación visual previa?" gatewayDirection="Diverging" />
    <bpmn:subProcess id="SubProcess_AtencionClinica" name="Realizar atención clínica" triggeredByEvent="false" />
    <bpmn:exclusiveGateway id="Gateway_Optica_UnirEvaluacion" name="Unir alternativas" gatewayDirection="Converging" />
    <bpmn:task id="Task_Optica_DefinirProducto" name="Definir producto y condiciones" />
    <bpmn:task id="Task_Optica_InformarPrecioPlazo" name="Informar precio y plazo" />
    <bpmn:task id="Task_Optica_RecibirDecision" name="Recibir decisión del cliente" />
    <bpmn:exclusiveGateway id="Gateway_Optica_Acepta" name="¿Cliente acepta?" gatewayDirection="Diverging" />
    <bpmn:task id="Task_Optica_CerrarSinVenta" name="Cerrar atención sin venta" />
    <bpmn:endEvent id="End_Optica_SinVenta" name="Atención finalizada sin venta" />
    <bpmn:task id="Task_Optica_SolicitarDatosPago" name="Solicitar datos y medio de pago" />
    <bpmn:task id="Task_Optica_RegistrarVentaPago" name="Registrar venta y pago" />
    <bpmn:task id="Task_Optica_EntregarComprobante" name="Entregar comprobante" />
    <bpmn:exclusiveGateway id="Gateway_Optica_EntregaInmediata" name="¿Entrega inmediata?" gatewayDirection="Diverging" />
    <bpmn:task id="Task_Optica_EntregarProducto" name="Entregar producto" />
    <bpmn:endEvent id="End_Optica_VentaEntregada" name="Venta finalizada con entrega" />
    <bpmn:task id="Task_Optica_CoordinarPreparacion" name="Coordinar preparación y retiro" />
    <bpmn:endEvent id="End_Optica_PendienteEntrega" name="Venta pendiente de entrega" />

    <bpmn:sequenceFlow id="OFlow_01" sourceRef="Start_Optica_Solicitud" targetRef="Task_Optica_IdentificarNecesidad" />
    <bpmn:sequenceFlow id="OFlow_02" sourceRef="Task_Optica_IdentificarNecesidad" targetRef="Task_Optica_PresentarAlternativas" />
    <bpmn:sequenceFlow id="OFlow_03" sourceRef="Task_Optica_PresentarAlternativas" targetRef="Gateway_Optica_RequiereEvaluacion" />
    <bpmn:sequenceFlow id="OFlow_04_No" name="No" sourceRef="Gateway_Optica_RequiereEvaluacion" targetRef="Gateway_Optica_UnirEvaluacion" />
    <bpmn:sequenceFlow id="OFlow_05_Si" name="Sí" sourceRef="Gateway_Optica_RequiereEvaluacion" targetRef="SubProcess_AtencionClinica" />
    <bpmn:sequenceFlow id="OFlow_06" sourceRef="SubProcess_AtencionClinica" targetRef="Gateway_Optica_UnirEvaluacion" />
    <bpmn:sequenceFlow id="OFlow_07" sourceRef="Gateway_Optica_UnirEvaluacion" targetRef="Task_Optica_DefinirProducto" />
    <bpmn:sequenceFlow id="OFlow_08" sourceRef="Task_Optica_DefinirProducto" targetRef="Task_Optica_InformarPrecioPlazo" />
    <bpmn:sequenceFlow id="OFlow_09" sourceRef="Task_Optica_InformarPrecioPlazo" targetRef="Task_Optica_RecibirDecision" />
    <bpmn:sequenceFlow id="OFlow_10" sourceRef="Task_Optica_RecibirDecision" targetRef="Gateway_Optica_Acepta" />
    <bpmn:sequenceFlow id="OFlow_11_No" name="No" sourceRef="Gateway_Optica_Acepta" targetRef="Task_Optica_CerrarSinVenta" />
    <bpmn:sequenceFlow id="OFlow_12" sourceRef="Task_Optica_CerrarSinVenta" targetRef="End_Optica_SinVenta" />
    <bpmn:sequenceFlow id="OFlow_13_Si" name="Sí" sourceRef="Gateway_Optica_Acepta" targetRef="Task_Optica_SolicitarDatosPago" />
    <bpmn:sequenceFlow id="OFlow_14" sourceRef="Task_Optica_SolicitarDatosPago" targetRef="Task_Optica_RegistrarVentaPago" />
    <bpmn:sequenceFlow id="OFlow_15" sourceRef="Task_Optica_RegistrarVentaPago" targetRef="Task_Optica_EntregarComprobante" />
    <bpmn:sequenceFlow id="OFlow_16" sourceRef="Task_Optica_EntregarComprobante" targetRef="Gateway_Optica_EntregaInmediata" />
    <bpmn:sequenceFlow id="OFlow_17_Si" name="Sí" sourceRef="Gateway_Optica_EntregaInmediata" targetRef="Task_Optica_EntregarProducto" />
    <bpmn:sequenceFlow id="OFlow_18" sourceRef="Task_Optica_EntregarProducto" targetRef="End_Optica_VentaEntregada" />
    <bpmn:sequenceFlow id="OFlow_19_No" name="No" sourceRef="Gateway_Optica_EntregaInmediata" targetRef="Task_Optica_CoordinarPreparacion" />
    <bpmn:sequenceFlow id="OFlow_20" sourceRef="Task_Optica_CoordinarPreparacion" targetRef="End_Optica_PendienteEntrega" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_VentaPresencial">
    <bpmndi:BPMNPlane id="BPMNPlane_VentaPresencial" bpmnElement="Collaboration_VentaPresencial">
      <bpmndi:BPMNShape id="Shape_Participant_Cliente" bpmnElement="Participant_Cliente" isHorizontal="true"><dc:Bounds x="30" y="160" width="2540" height="320" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Cliente" bpmnElement="Start_Cliente"><dc:Bounds x="100" y="295" width="40" height="40" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Cliente_LlegarSolicitar" bpmnElement="Task_Cliente_LlegarSolicitar"><dc:Bounds x="170" y="270" width="150" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Cliente_ExpresarNecesidad" bpmnElement="Task_Cliente_ExpresarNecesidad"><dc:Bounds x="370" y="270" width="150" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Cliente_EvaluarPropuesta" bpmnElement="Task_Cliente_EvaluarPropuesta"><dc:Bounds x="960" y="270" width="150" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Cliente_Acepta" bpmnElement="Gateway_Cliente_Acepta" isMarkerVisible="true"><dc:Bounds x="1160" y="288" width="55" height="55" /><bpmndi:BPMNLabel><dc:Bounds x="1115" y="250" width="145" height="25" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Cliente_ComunicarRechazo" bpmnElement="Task_Cliente_ComunicarRechazo"><dc:Bounds x="1270" y="190" width="150" height="75" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Cliente_SinCompra" bpmnElement="End_Cliente_SinCompra"><dc:Bounds x="1470" y="208" width="40" height="40" /><bpmndi:BPMNLabel><dc:Bounds x="1430" y="250" width="120" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Cliente_ComunicarAceptacion" bpmnElement="Task_Cliente_ComunicarAceptacion"><dc:Bounds x="1270" y="365" width="150" height="75" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Cliente_DatosPago" bpmnElement="Task_Cliente_DatosPago"><dc:Bounds x="1510" y="365" width="165" height="75" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Cliente_RecibirComprobante" bpmnElement="Task_Cliente_RecibirComprobante"><dc:Bounds x="1870" y="365" width="165" height="75" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Cliente_Entrega" bpmnElement="Gateway_Cliente_Entrega" isMarkerVisible="true"><dc:Bounds x="2070" y="375" width="55" height="55" /><bpmndi:BPMNLabel><dc:Bounds x="2025" y="340" width="145" height="25" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Cliente_RecibirProducto" bpmnElement="Task_Cliente_RecibirProducto"><dc:Bounds x="2170" y="300" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Cliente_CompraCompletada" bpmnElement="End_Cliente_CompraCompletada"><dc:Bounds x="2430" y="315" width="40" height="40" /><bpmndi:BPMNLabel><dc:Bounds x="2375" y="355" width="150" height="25" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Cliente_EsperarPreparacion" bpmnElement="Task_Cliente_EsperarPreparacion"><dc:Bounds x="2170" y="395" width="160" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Cliente_PendienteEntrega" bpmnElement="End_Cliente_PendienteEntrega"><dc:Bounds x="2430" y="410" width="40" height="40" /><bpmndi:BPMNLabel><dc:Bounds x="2365" y="450" width="170" height="25" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Participant_Optica" bpmnElement="Participant_Optica" isHorizontal="true"><dc:Bounds x="30" y="540" width="2540" height="700" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Ventas" bpmnElement="Lane_Ventas" isHorizontal="true"><dc:Bounds x="80" y="540" width="2490" height="470" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Clinica" bpmnElement="Lane_Clinica" isHorizontal="true"><dc:Bounds x="80" y="1010" width="2490" height="230" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Optica_Solicitud" bpmnElement="Start_Optica_Solicitud"><dc:Bounds x="120" y="710" width="40" height="40" /><bpmndi:BPMNLabel><dc:Bounds x="85" y="755" width="110" height="35" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Optica_IdentificarNecesidad" bpmnElement="Task_Optica_IdentificarNecesidad"><dc:Bounds x="210" y="690" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Optica_PresentarAlternativas" bpmnElement="Task_Optica_PresentarAlternativas"><dc:Bounds x="390" y="690" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Optica_RequiereEvaluacion" bpmnElement="Gateway_Optica_RequiereEvaluacion" isMarkerVisible="true"><dc:Bounds x="590" y="703" width="55" height="55" /><bpmndi:BPMNLabel><dc:Bounds x="545" y="660" width="150" height="35" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SubProcess_AtencionClinica" bpmnElement="SubProcess_AtencionClinica" isExpanded="false"><dc:Bounds x="740" y="1085" width="180" height="85" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Optica_UnirEvaluacion" bpmnElement="Gateway_Optica_UnirEvaluacion" isMarkerVisible="true"><dc:Bounds x="850" y="703" width="55" height="55" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Optica_DefinirProducto" bpmnElement="Task_Optica_DefinirProducto"><dc:Bounds x="950" y="690" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Optica_InformarPrecioPlazo" bpmnElement="Task_Optica_InformarPrecioPlazo"><dc:Bounds x="1130" y="690" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Optica_RecibirDecision" bpmnElement="Task_Optica_RecibirDecision"><dc:Bounds x="1310" y="690" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Optica_Acepta" bpmnElement="Gateway_Optica_Acepta" isMarkerVisible="true"><dc:Bounds x="1490" y="703" width="55" height="55" /><bpmndi:BPMNLabel><dc:Bounds x="1460" y="665" width="115" height="25" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Optica_CerrarSinVenta" bpmnElement="Task_Optica_CerrarSinVenta"><dc:Bounds x="1590" y="585" width="140" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Optica_SinVenta" bpmnElement="End_Optica_SinVenta"><dc:Bounds x="1780" y="600" width="40" height="40" /><bpmndi:BPMNLabel><dc:Bounds x="1740" y="645" width="120" height="35" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Optica_SolicitarDatosPago" bpmnElement="Task_Optica_SolicitarDatosPago"><dc:Bounds x="1590" y="830" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Optica_RegistrarVentaPago" bpmnElement="Task_Optica_RegistrarVentaPago"><dc:Bounds x="1780" y="830" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Optica_EntregarComprobante" bpmnElement="Task_Optica_EntregarComprobante"><dc:Bounds x="1960" y="830" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Optica_EntregaInmediata" bpmnElement="Gateway_Optica_EntregaInmediata" isMarkerVisible="true"><dc:Bounds x="2140" y="843" width="55" height="55" /><bpmndi:BPMNLabel><dc:Bounds x="2100" y="805" width="135" height="25" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Optica_EntregarProducto" bpmnElement="Task_Optica_EntregarProducto"><dc:Bounds x="2240" y="755" width="140" height="70" /></bpmndi:BPMNShape>
