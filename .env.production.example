# Copiar a .env.production solamente en el servidor Linux y completar valores.
# No versionar ese archivo ni compartirlo por correo o chat.

# Variables que Docker Compose lee en el host.
APP_IMAGE_TAG=local
APP_PORT=3000
APP_BIND_ADDRESS=127.0.0.1
APP_DOMAIN=stylo.example.edu
DATABASE_CA_CERT_PATH=/opt/optica-stylo/secrets/postgresql-ca.crt

# PostgreSQL institucional. Codificar caracteres especiales de la contraseña
# dentro de la URL (por ejemplo, @ como %40).
DATABASE_URL=postgresql://usuario:contrasena@postgresql.universidad.edu:5432/opticastylo
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000

APP_TIME_ZONE=America/Santiago
APP_PUBLIC_URL=https://stylo.example.edu

# En producción ALLOWED_DEV_ORIGINS debe quedar vacío.
ALLOWED_DEV_ORIGINS=

MERCADO_PAGO_MODE=sandbox
MERCADO_PAGO_PRODUCTION_ENABLED=false
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

EMAIL_MODE=disabled
EMAIL_FROM=Stylo Vivo <correos@example.com>
EMAIL_DOMAIN_VERIFIED=false
EMAIL_TEST_RECIPIENT=pruebas@example.com
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

CRON_SECRET=
EMAIL_PROVIDER_TIMEOUT_MS=8000
EMAIL_BATCH_SIZE=20
EMAIL_LOCK_SECONDS=60
EMAIL_MAX_ATTEMPTS=6
EMAIL_RETRY_BASE_SECONDS=30
EMAIL_RETRY_MAX_SECONDS=3600
EMAIL_APPOINTMENT_REMINDER_HOURS=24

POS_SALES_EMAIL=ventas.pos@opticastylo.cl
POS_SALES_PASSWORD=
