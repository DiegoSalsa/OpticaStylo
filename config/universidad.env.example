# Copiar este archivo fuera del repositorio como ~/optica-stylo.env y aplicar chmod 600.
NODE_ENV=production
TRUST_PROXY=true
NEXT_TELEMETRY_DISABLED=1

# PostgreSQL debe aceptar TLS con un certificado verificable.
DATABASE_URL=postgresql://usuario:contrasena@servidor:5432/opticastylo
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# URL pública HTTPS del entorno universitario cuando exista un nombre resoluble.
APP_PUBLIC_URL=
APP_TIME_ZONE=America/Santiago

# Recuperación de contraseña. El secreto debe contener al menos 32 bytes aleatorios.
PASSWORD_RESET_APP_ORIGIN=
PASSWORD_RESET_TOKEN_SECRET=

# Archivos de productos y recetas.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Lectura automática de recetas, inicialmente deshabilitada.
OPENAI_API_KEY=
OPENAI_PRESCRIPTION_READER_ENABLED=false

# Los datos demostrativos deben cargarse en la base universitaria, no desde el catálogo local.
STORE_INCLUDE_TEST_DATA=false

# Mercado Pago debe permanecer en sandbox en el servidor universitario.
MERCADO_PAGO_MODE=sandbox
MERCADO_PAGO_PRODUCTION_ENABLED=false
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Correo transaccional deshabilitado hasta configurar un dominio verificado.
EMAIL_MODE=disabled
EMAIL_FROM=
EMAIL_DOMAIN_VERIFIED=false
EMAIL_TEST_RECIPIENT=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
CRON_SECRET=
EMAIL_PROVIDER_TIMEOUT_MS=8000
EMAIL_BATCH_SIZE=20
EMAIL_LOCK_SECONDS=60
EMAIL_MAX_ATTEMPTS=6
EMAIL_RETRY_BASE_SECONDS=30
EMAIL_RETRY_MAX_SECONDS=3600
EMAIL_APPOINTMENT_REMINDER_HOURS=24
