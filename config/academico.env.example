# Copia esta plantilla a .env.academico en la raíz y limita sus permisos (chmod 600).
# Para acceso desde el aula, usa la IP local de la interfaz de esa red.
ACADEMIC_BIND_IP=127.0.0.1
ACADEMIC_PORT=3000
# Usa el origen que abrirá el navegador, incluido el puerto cuando corresponda.
ACADEMIC_PUBLIC_URL=http://127.0.0.1:3000
# Habilita HTTP solo en loopback o en la red restringida de la evaluación.
# Con HTTPS, deja esta opción en false para conservar las cookies Secure.
ACADEMIC_ALLOW_HTTP=false

# Usa nombres de hasta 63 caracteres con letras minúsculas, números y guiones bajos.
# El primer carácter debe ser una letra o un guion bajo.
# Conserva estos valores mientras reutilices el mismo volumen PostgreSQL.
ACADEMIC_DB_USER=stylo_academico
ACADEMIC_DB_NAME=opticastylo_academico
# Genera una contraseña nueva con openssl rand -hex 24 y guárdala en .env.academico.
# Usa caracteres sin escape en una URL (letras, números y . _ ~ -).
ACADEMIC_DB_PASSWORD=

# El Compose deja deshabilitados correo, despachos, lector de recetas y operaciones
# programadas. Mercado Pago y Cloudinary quedan sin credenciales.
