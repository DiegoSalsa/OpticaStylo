  users_appointments_created_byTousers users?                       @relation("appointments_created_byTousers", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  patients                             patients                     @relation(fields: [patient_id], references: [id], onUpdate: NoAction)
  professional_profiles                professional_profiles        @relation(fields: [professional_id], references: [user_id], onUpdate: NoAction)
  users_appointments_updated_byTousers users?                       @relation("appointments_updated_byTousers", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
