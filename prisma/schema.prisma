/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model appointment_events {
  id                BigInt       @id @default(autoincrement()) @map("id")
  appointment_id    String       @map("appointment_id") @db.Uuid
  event_type        String       @map("event_type") @db.VarChar(30)
  previous_start_at DateTime?    @map("previous_start_at") @db.Timestamptz(6)
  new_start_at      DateTime?    @map("new_start_at") @db.Timestamptz(6)
  previous_end_at   DateTime?    @map("previous_end_at") @db.Timestamptz(6)
  new_end_at        DateTime?    @map("new_end_at") @db.Timestamptz(6)
  previous_status   String?      @map("previous_status") @db.VarChar(30)
  new_status        String?      @map("new_status") @db.VarChar(30)
  details           String?      @map("details")
  performed_by      String?      @map("performed_by") @db.Uuid
  created_at        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  appointments      appointments @relation(fields: [appointment_id], references: [id], onUpdate: NoAction)
  users             users?       @relation(fields: [performed_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([appointment_id, created_at, id], map: "appointment_events_appointment_index")
  @@map("appointment_events")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model appointments {
  id                                   String                       @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  patient_id                           String                       @map("patient_id") @db.Uuid
  professional_id                      String                       @map("professional_id") @db.Uuid
  start_at                             DateTime                     @map("start_at") @db.Timestamptz(6)
