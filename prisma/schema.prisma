  status                               String                       @default("CONFIRMED") @map("status") @db.VarChar(30)
  internal_notes                       String?                      @map("internal_notes") @db.VarChar(1000)
  cancellation_reason                  String?                      @map("cancellation_reason") @db.VarChar(500)
