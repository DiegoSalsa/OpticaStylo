# Conexión de ejemplo. No incluir credenciales reales en este archivo.
DATABASE_URL=postgresql://postgres:contrasena@localhost:5432/opticastylo
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Zona horaria usada para convertir la agenda local a instantes UTC.
APP_TIME_ZONE=America/Santiago

# Hosts adicionales que pueden cargar recursos de Next.js durante desarrollo.
# Separar con comas; útil para probar desde teléfonos en la red local.
ALLOWED_DEV_ORIGINS=192.168.1.7

# Checkout Pro de Mercado Pago. Usar credenciales de prueba en desarrollo.
MERCADO_PAGO_MODE=sandbox
MERCADO_PAGO_PRODUCTION_ENABLED=false
MERCADO_PAGO_PUBLIC_KEY=APP_USR-public-key-de-prueba
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-access-token-de-prueba

# Se obtiene en Tus integraciones > Webhooks; no corresponde al código de verificación.
MERCADO_PAGO_WEBHOOK_SECRET=clave-secreta-del-webhook

# Dominio HTTPS público para retornos y webhooks. No usar localhost.
APP_PUBLIC_URL=https://tienda.example.com

# Correo transaccional centralizado. El valor inicial seguro es disabled.
# test redirige todos los mensajes a EMAIL_TEST_RECIPIENT; live exige un
# dominio verificado y EMAIL_DOMAIN_VERIFIED=true.
EMAIL_MODE=disabled
EMAIL_FROM=Stylo Vivo <correos@example.com>
EMAIL_DOMAIN_VERIFIED=false
EMAIL_TEST_RECIPIENT=pruebas@example.com
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Secreto independiente (mínimo 16 caracteres). Vercel Cron lo envía como
# Authorization: Bearer cuando la configuración de cron sea autorizada.
CRON_SECRET=

# Límites del trabajador y recordatorio provisional configurable.
EMAIL_PROVIDER_TIMEOUT_MS=8000
EMAIL_BATCH_SIZE=20
EMAIL_LOCK_SECONDS=60
EMAIL_MAX_ATTEMPTS=6
EMAIL_RETRY_BASE_SECONDS=30
EMAIL_RETRY_MAX_SECONDS=3600
EMAIL_APPOINTMENT_REMINDER_HOURS=24

# Opcionales para `npm run users:create-sales`. Si no se define contraseña,
# el comando genera una aleatoria fuerte y la muestra una sola vez.
POS_SALES_EMAIL=ventas.pos@opticastylo.cl
POS_SALES_PASSWORD=
