    {
      "name": "01 - Estado del servicio",
      "item": [
        {
          "name": "Health check responde correctamente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Comprueba que la API esté disponible antes de ejecutar el resto de la colección."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Respeta el contrato exitoso', () => {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.service).to.eql('optica-stylo');",
                  "  pm.expect(json.data.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
