# Archivos generados que no deben versionarse.

# Dependencias
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Pruebas
/coverage
/tmp/

# Herramientas locales
/postman/

# Next.js
/.next/
/out/

# Compilaciones de producción
/build
/output/

# Las fotografías nuevas del catálogo se almacenan exclusivamente en Cloudinary.
/public/images/products/

# Archivos del sistema
.DS_Store
Thumbs.db
*.pem

# Configuración local de editores
/.idea/
/.vscode/
*.swp

# Registros de depuración
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next-dev.*.log
.eslintcache

# Variables de entorno locales
.env*
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
